{
  "name": "wortpause",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.js",
    "build:mobile": "node scripts/build-mobile.js",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
